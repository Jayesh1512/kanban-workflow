# Optional Compose overrides; do not copy key values from ai.env into this file.
AI_ENV_PATH=/Users/jys/Documents/Projects/hello/.local-preview-20261012/ai.env
BACKEND_PORT=3000
VIKUNJA_PORT=3456
TIMEZONE=Asia/Kolkata
# Native GPT-6 Luna Decisions; the key stays in AI_ENV_PATH as OPENAI_API_KEY.
# MOVEMENT_PROVIDER=openai
# JEV_ENDPOINT=https://api.openai.com/v1/decisions
# JEV_MODEL=gpt-6-luna
# Optional per-deployment extraction limits; blank preserves AI_ENV_PATH settings.
# OPENAI_TIMEOUT_MS=90000
# OPENAI_MAX_OUTPUT_TOKENS=8192
# Published tdl profile is default; custom uses your complete API pair.
TELEGRAM_APPLICATION_PROFILE=tdl
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_HISTORY_BATCH_SIZE=100
TELEGRAM_HISTORY_MAX_BATCHES=10
# Direct host runtime also supports DATABASE_URL, VIKUNJA_URL, VIKUNJA_USERNAME,
# VIKUNJA_PASSWORD/VIKUNJA_API_TOKEN and TELEGRAM_SESSION_PATH.
# After the existing data has been restored and verified in Supabase:
# COMPOSE_FILE=compose.yaml:compose.supabase.yaml
# SUPABASE_CONFIG_DIR=./.local/supabase
# Private credentials and migration instructions: deploy/supabase/README.md
# Supabase remote DB defaults to 20 dialogs per discovery turn (local default 500).
# TELEGRAM_DISCOVERY_BATCH_SIZE=20
