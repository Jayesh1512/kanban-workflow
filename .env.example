# Copy to a private server-only .env; values are not loaded by pnpm start automatically.
# Choose either custom Telegram credentials below or the tdl profile described in docs/connect-telegram.md.
KANBAN_DATA_DIR=./data
KANBAN_SECRET_KEY=<base64-encoded-32-byte-key>
KANBAN_HOST=127.0.0.1
KANBAN_PORT=8787
KANBAN_ORIGIN=http://localhost:8787
CONNECTORS=telegram
TELEGRAM_API_ID=<application-id>
TELEGRAM_API_HASH=<application-hash>
TELEGRAM_APP_OWNER=<named-teammate>
FIXTURE_PATH=<synthetic-recording-path>
# Cloud AI: supply both the key and a Responses-compatible model ID.
MODEL_PROVIDER=openai
MODEL_SCRIPT_PATH=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_OUTPUT_TOKENS=4096
OPENAI_MAX_ATTEMPTS=2
# Separate movement provider; set either provider to disabled to turn it off.
MOVEMENT_PROVIDER=jev
JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_API_KEY=
MOVEMENT_REPLAY_PATH=
JEV_TIMEOUT_MS=10000
JEV_MAX_ATTEMPTS=1
