# Allowlist: private .env, local sessions, test artifacts and host modules never enter context.
**
!Dockerfile
!package.json
!package-lock.json
!tsconfig.json
!tsconfig.build.json
!src/
!src/**
!db/
!db/migrations/
!db/migrations/*.sql
!deploy/
!deploy/**
# Deployment directories can contain owner-created private credentials too.
**/*.env
**/*.env.*
**/*.pem
**/*.key
**/*.crt
