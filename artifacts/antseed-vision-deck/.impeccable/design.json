      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;height:var(--button-height,44px);padding:0 var(--button-padding-x,20px);border:0;border-radius:var(--radius-button,10px);font:500 15px/20px var(--font-sans,Geist,system-ui,sans-serif);text-decoration:none;cursor:pointer;transition:background-color var(--dur-feedback,150ms);background:var(--color-button-fill,#4f7a24);color:var(--color-button-text,#fff);box-shadow:var(--button-shadow, inset 0 -2px 1px #3b5e17)}.ds-primary:hover{background:var(--color-button-fill-hover,#436a1e)}.ds-primary:focus-visible{outline:2px solid var(--color-focus,#4f7a24);outline-offset:2px;}"
