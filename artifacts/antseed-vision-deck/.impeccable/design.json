  "narrative": {
    "northStar": "Friendly and technical",
    "overview": "This document applies to the Antseed vision presentation in this directory. The published Antseed v1 guide, snapshotted in `brand/AGENTS.md` and `brand/DESIGN.md`, establishes the identity; `brand/tokens.css` and `brand/components.css` supply its numeric and component rules. The user-approved compliance pass supersedes the previous warm-paper palette, acid action buttons and uniform ELSH 11 headings. Parent CRM and neobank artifact documents do not govern this deck.\n\nClean structure carries the technical story. Approved watercolor landscapes and round dots supply its friendly half. The presentation remains quiet and readable while preserving the official logos, separate day/night paintings, source evidence and qualifications.",
    "keyCharacteristics": [
      "White paper rails and dot-matrix margins by day, distinct charcoal page and rail at night.",
      "Two-tone Geist Pixel titles above plain Geist prose.",
      "Approved watercolor pairs and original monochrome logos.",
      "Flat narrative rows, accessible controls and a secondary evidence dialog."
    ],
    "rules": [
      {
        "name": "The Color Role Rule",
        "body": "Action green fills the primary button in both themes. Night green text uses its separate text token. Acid belongs to light effects and night dot-ants, never the primary CTA.",
        "section": "colors"
      },
      {
        "name": "The Two-Tone Rule",
        "body": "The cover uses the H1 pixel shape and gray second line without a final period. Section titles use the section pixel shape, a gray second half and a final period.",
        "section": "typography"
      },
      {
        "name": "The Paper Rail Rule",
        "body": "The dot matrix belongs in the margins. Content and the logo sit on the rail, with dotted rail outlines.",
        "section": "layout"
      },
      {
        "name": "The Paired Painting Rule",
        "body": "Day and night use separate approved paintings. A theme change reveals the new painting from the sky downward; it does not recolor the day image with a filter.",
        "section": "components"
      }
    ],
    "dos": [
      "Do use the official color, type, radius and component tokens before adding local values.",
      "Do keep words readable independently of artwork and source evidence reachable from each slide.",
      "Do use the original logo files and approved day/night painting pairs without stretching or recoloring them.",
      "Do place round peer dots on the 8px coordinate grid and keep the network composition free of a central hub.",
      "Do retain keyboard navigation, focus return, inert inactive content and a readable reduced-motion still."
    ],
    "donts": [
      "Don’t reinstate cream UI paper or acid primary action buttons.",
      "Don’t use font weights outside 400 and 500 or apply negative tracking to ordinary prose and subheads.",
      "Don’t turn sparse watercolor panels into dense illustrations or invent a new mascot.",
      "Don’t add idle seed or dot loops, repeated text entrances or hidden running animations.",
      "Don’t scale desktop text down as the mobile reading layout; stack the content instead."
    ]
  }
}
