  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The filled green deck action, with a shallow lip and accessible focus.",
      "html": "<a class=\"ds-button\" href=\"#\">Book a call</a>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;height:44px;padding:0 20px;border:0;border-radius:10px;background:var(--color-button-fill);color:var(--color-button-text);font:500 15px/20px var(--font-sans);text-decoration:none;white-space:nowrap;box-shadow:var(--button-shadow);transition:background-color 150ms}.ds-button:hover{background:var(--color-button-fill-hover)}.ds-button:focus-visible{outline:2px solid var(--color-focus);outline-offset:2px}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}"
    },
    {
      "name": "Presentation navigation",
      "kind": "nav",
      "description": "Icon controls, current-slide dot and a tabular mono count.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Presentation controls\"><button class=\"ds-control\" aria-label=\"Previous slide\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m14 6-6 6 6 6M8 12h12\"/></svg></button><button class=\"ds-dot\" aria-label=\"Slide 1\" aria-current=\"true\"></button><span class=\"ds-count\">1 / 8</span><button class=\"ds-control\" aria-label=\"Next slide\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m10 6 6 6-6 6M16 12H4\"/></svg></button></nav>",
      "css": ".ds-nav{display:inline-flex;align-items:center;gap:8px;padding:8px 16px;border-radius:8px;background:var(--color-rail);color:var(--color-text);box-shadow:var(--glass-pill-ring)}.ds-control{display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;padding:8px;border:0;border-radius:5px;background:transparent;color:inherit;cursor:pointer}.ds-control svg{width:20px;height:20px}.ds-control:hover{background:var(--color-tile-hover)}.ds-control:disabled{opacity:.35}.ds-count{font:400 12.5px/18px var(--font-mono);font-variant-numeric:tabular-nums;color:var(--color-text-small);min-width:48px;text-align:center}.ds-dot{position:relative;width:32px;height:40px;padding:0;border:0;background:transparent;cursor:pointer}.ds-dot:after{content:\"\";position:absolute;width:8px;height:8px;left:12px;top:16px;border-radius:50%;background:var(--color-green-text)}.ds-control:focus-visible,.ds-dot:focus-visible{outline:2px solid var(--color-focus);outline-offset:4px}"
    },
    {
      "name": "Cover context pill",
      "kind": "chip",
      "refersTo": "cover-pill",
      "description": "Short contextual label on the cover painting.",
      "html": "<p class=\"ds-pill\">A partner brief for onchain neobanks</p>",
      "css": ".ds-pill{display:inline-flex;align-items:center;gap:2px;height:24px;margin:0;padding:0 11px;border-radius:999px;background:var(--glass-pill-background);box-shadow:var(--glass-pill-ring);backdrop-filter:var(--glass-pill-backdrop);color:var(--color-ink);font:400 12px/16px var(--font-sans);white-space:nowrap}"
    },
    {
      "name": "Pinned topic and pixel heading",
      "kind": "custom",
      "refersTo": "topic",
      "description": "The approved source-template topic marker and measured two-tone section heading.",
      "html": "<div class=\"ds-head\"><p class=\"ds-topic\">The partner offer</p><h2 class=\"ds-heading\">One key. Network prices. <span>Your reward.</span></h2></div>",
      "css": ".ds-topic{display:flex;align-items:center;gap:8px;margin:0;font:400 13px/18px var(--font-sans);color:var(--color-text-small)}.ds-topic:before{content:\"\";width:6px;height:6px;border-radius:50%;background:var(--color-green);flex-shrink:0}.ds-heading{margin:14px 0 0;font:400 34px/36px var(--font-pixel);font-variation-settings:\"ELSH\" 40;letter-spacing:-.04em;color:var(--color-text)}.ds-heading span{color:var(--color-text-grey)}"
    },
    {
      "name": "Offer card text and frame",
      "kind": "card",
      "refersTo": "offer-card",
      "description": "The implemented offer-card frame and type; the full artifact adds its original ant and paired watercolor strip.",
      "html": "<article class=\"ds-card\"><p class=\"ds-card-label\">Antseed brings</p><h3 class=\"ds-card-title\">One API key</h3><p class=\"ds-card-body\">Access to model families through a single API.</p></article>",
      "css": ".ds-card{box-sizing:border-box;position:relative;width:339.2px;max-width:100%;height:302px;overflow:hidden;padding:20px 22px;border-radius:11px;background:var(--color-tile);border:0;box-shadow:inset 0 0 0 1px var(--color-tile-line)}.ds-card-label{margin:0;font:400 13px/18px var(--font-sans);color:var(--color-green-text)}.ds-card-title{margin:8px 0 0;font:400 24px/28px var(--font-pixel);font-variation-settings:\"ELSH\" 20;color:var(--color-text)}.ds-card-body{position:relative;z-index:2;margin:12px 0 0;max-width:230px;font:400 15px/22px var(--font-sans);color:var(--color-text-body)}"
    },
    {
      "name": "Pixel metric",
      "kind": "custom",
      "description": "Dotted divider, subdued label and tabular ELSH-20 numeral.",
      "html": "<div class=\"ds-figure\"><p class=\"ds-figure-label\">Models</p><p class=\"ds-figure-value\">920</p></div>",
      "css": ".ds-figure{padding-top:8px;border-top:2px dotted color-mix(in srgb,var(--color-text) 25%,transparent)}.ds-figure-label{margin:0;font:400 13px/16px var(--font-sans);color:var(--color-text-small)}.ds-figure-value{margin:14px 0 0;font:400 32px/36px var(--font-pixel);font-variation-settings:\"ELSH\" 20;font-variant-numeric:tabular-nums;color:var(--color-text)}"
    },
    {
      "name": "Native price bar",
      "kind": "custom",
      "description": "Editable source-price row with a native 32px track and right-aligned mono amount.",
      "html": "<div class=\"ds-price\"><span>After 50% back</span><div class=\"ds-track\"><div class=\"ds-fill\"></div></div><strong>$0.84</strong></div>",
      "css": ".ds-price{display:grid;grid-template-columns:150px 266px 88px;gap:16px;align-items:center;font:400 15px/22px var(--font-sans);color:var(--color-text)}.ds-track{height:32px;overflow:hidden;border-radius:5px;background:var(--color-tile);box-shadow:inset 0 0 0 1px var(--color-tile-line)}.ds-fill{height:100%;width:21%;border-radius:5px;background:var(--color-green)}.ds-price strong{font:400 16px/20px var(--font-mono);text-align:right;color:var(--color-green-text)}"
    },
    {
      "name": "Model price card",
      "kind": "card",
      "refersTo": "model-card",
      "description": "Native model name, discount and definition-list prices; the artifact adds an original extracted model mark.",
      "html": "<article class=\"ds-model\"><span class=\"ds-saving\">−78%</span><h3>GPT-6 Astra</h3><dl><dt>List</dt><dd><s>$10.00</s></dd><dt>After 50% back</dt><dd>$2.23</dd></dl></article>",
      "css": ".ds-model{box-sizing:border-box;display:flex;flex-direction:column;width:168px;height:150px;padding:16px;border:0;border-radius:11px;box-shadow:inset 0 0 0 1px var(--color-tile-line);background:var(--color-tile);color:var(--color-text)}.ds-saving{align-self:flex-end;font:400 18px/24px var(--font-mono);color:var(--color-green-text)}.ds-model h3{margin:auto 0 0;font:500 14px/20px var(--font-sans)}.ds-model dl{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:3px 4px;margin:6px 0 0;font:400 12px/16px var(--font-sans);color:var(--color-text-small)}.ds-model dd{margin:0;white-space:nowrap;font:400 12.5px/16px var(--font-mono)}.ds-model dd:last-child{color:var(--color-green-text)}"
    },
    {
      "name": "Smoked Gateway terminal",
      "kind": "custom",
      "description": "Source-terminal translucent smoke without backdrop blur, shared shadow, title bar, dotted pane dividers and native code; no idle cursor blink.",
      "html": "<div class=\"ds-terminal\"><div class=\"ds-bar\"><div class=\"ds-lights\"><i></i><i></i><i></i></div><span class=\"ds-terminal-title\">antseed — zsh</span></div><div class=\"ds-pane\"><p><b>~ $ </b><span class=\"ds-command\">antseed gateway start</span></p><p>API-key gateway listening on <span class=\"ds-url\">http://127.0.0.1:8379/v1</span></p></div><div class=\"ds-pane\"><p><b>~ $ </b><span class=\"ds-command\">export ANTSEED_API_KEY=\"antseed_…\"</span></p></div></div>",
      "css": ".ds-terminal{box-sizing:border-box;position:relative;width:552px;max-width:100%;overflow:hidden;border-radius:8px;border:var(--glass-smoked-border);background:var(--glass-smoked-background);box-shadow:var(--glass-smoked-shadow);backdrop-filter:none;-webkit-backdrop-filter:none;font:var(--type-terminal);color:var(--glass-smoked-text);text-align:left}.ds-bar{position:relative;display:flex;align-items:center;height:34px;padding:0 14px;background:var(--glass-smoked-bar);border-bottom:2px dotted var(--glass-smoked-dot)}.ds-lights{display:flex;gap:6.8px}.ds-lights i{width:10px;height:10px;border-radius:50%;background:#ff5f57}.ds-lights i:nth-child(2){background:#febc2e}.ds-lights i:nth-child(3){background:#28c840}.ds-terminal-title{position:absolute;left:50%;transform:translateX(-50%);font:var(--type-terminal-title);letter-spacing:.2px;color:var(--glass-smoked-chrome);white-space:nowrap}.ds-pane{padding:15.3px 22.1px 17px;overflow-wrap:anywhere}.ds-pane+.ds-pane{border-top:2px dotted var(--glass-smoked-dot);padding-top:16.15px}.ds-pane p{margin:0;white-space:pre-wrap}.ds-pane b{font-weight:400;color:var(--glass-smoked-prompt)}.ds-command{color:var(--glass-smoked-strong)}.ds-url{color:var(--glass-smoked-url)}"
    },
