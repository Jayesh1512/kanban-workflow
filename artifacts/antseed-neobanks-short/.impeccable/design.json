  "narrative": {
    "northStar": "Antseed’s illustrated partner rail",
    "overview": "The supplied Antseed PDF is the visual authority: a white or dark presentation rail inside dotted margins, measured pixel headlines, restrained Geist text, and original ant characters against watercolor landscapes. The visual tone is clear, light and approachable, with the authored technical chapters held in night colors.\n\nThis records the completed eight-slide condensation. Source measurements override the earlier intro-deck approximation. Pinned section topics, illustrated offer cards and compact merged-content rows are approved adaptations; claims and editorial decisions belong in story-map.json. The eight slides follow the PDF’s styles without claiming to reproduce all fifteen source pages pixel for pixel.",
    "keyCharacteristics": [
      "Measured source typography and a 16px paper frame",
      "Two-tone variable pixel headings and Geist 400/500 text",
      "Original PDF ants, paintings, extracted icons and model marks",
      "Fixed dark technical chapters with optional global night",
      "Editable native text and pricing, responsive reflow and quiet controls"
    ],
    "rules": [
      {
        "name": "The Technical Night Rule",
        "body": "The Gateway and network snapshot retain the source dark rail, text and night artwork in either global theme.",
        "section": "colors"
      },
      {
        "name": "The Two-Tone Heading Rule",
        "body": "Keep the primary phrase in text ink and its companion phrase in the appropriate heading gray; retain the measured tracking and pixel variation for each role.",
        "section": "typography"
      },
      {
        "name": "The Still-at-Rest Rule",
        "body": "Nothing animates while idle. Motion answers a control action and stops for reduced motion, hidden documents and still captures.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the supplied PDF’s measured typography, paper frame, content gutter and component proportions.",
      "Do preserve the approved pinned topics, illustrated offer cards and compact merged-content rows.",
      "Do use original PDF ants, logos, paintings, extracted icons and model marks; keep the source Solid artwork intact.",
      "Do keep pricing as editable native bars and model cards, with labels readable independently of color.",
      "Do reflow the selected slide into a scrollable reading layout at the phone breakpoint.",
      "Do retain visible focus, accessible control labels, the live slide count and inert inactive slides."
    ],
    "donts": [
      "Don't reinstate superseded approximate type sizes, card dimensions or pricing-table layouts.",
      "Don't add a Sources popup or footer-left slide descriptions.",
      "Don't replace the fixed night artwork in technical chapters with day scenes.",
      "Don't introduce idle character, cursor, dot or background animation.",
      "Don't inherit unused shared-kit sizes as though they were the effective deck styles."
