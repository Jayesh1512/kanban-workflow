# Copy to .local/supabase/credentials.env and fill in locally. Never send this file in chat.
# Supabase dashboard > Connect > Session pooler, port 5432. Keep the /postgres database.
# Copy the connection string. The password can be set separately below so special
# characters do not need to be manually percent-encoded in the URL.
SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF@aws-0-REGION.pooler.supabase.com:5432/postgres
SUPABASE_DATABASE_PASSWORD=
# Optional: sslmode=require in the URL uses encrypted libpq-compatible TLS.
# Default verify-full verifies the certificate; --ca-file supplies a custom CA.
